+test("only administrators can list rooms; directory excludes secrets and survives restart", async (t) => {
+  const f = await fixture(t);
+  const first = await f.create("Private directory room");
+  await f.create("Another room");
+  for (const headers of [
+    {},
+    { authorization: "Bearer wrong" },
+    { cookie: first.cookie },
+  ]) {
+    const denied = await f.app.inject({ url: "/api/rooms", headers });
+    assert.equal(denied.statusCode, 401);
+    assert.ok(!denied.body.includes("Private directory room"));
+  }
+  const headers = { authorization: `Bearer ${ADMIN}` };
+  await f.app.inject({
+    method: "POST",
+    url: `/api/rooms/${first.body.room.id}/access`,
+    headers: { ...headers, origin: ORIGIN },
+    payload: { invitation: "disable", revokeSessions: false },
+  });
+  await f.restart();
+  const response = await f.app.inject({ url: "/api/rooms", headers });
+  assert.equal(response.statusCode, 200);
+  assert.equal(response.headers["cache-control"], "no-store");
+  assert.equal(response.json().nextOffset, null);
+  assert.equal(response.json().rooms.length, 2);
+  assert.deepEqual(
+    response
+      .json()
+      .rooms.find((room: { id: string }) => room.id === first.body.room.id),
+    { ...first.body.room, invitationEnabled: false },
+  );
+  assert.ok(!response.body.includes(first.invitation));
+  assert.ok(!response.body.includes("hash"));
+  assert.ok(!response.body.includes("participant"));
+  for (const offset of ["-1", "1.2", "abc", "9999999999"]) {
+    assert.equal(
+      (await f.app.inject({ url: `/api/rooms?offset=${offset}`, headers }))
+        .statusCode,
+      400,
+    );
+  }
+});
+
+test("room directory pages are bounded with deterministic ordering", async (t) => {
+  const f = await fixture(t);
+  const rooms = new Rooms(f.config.databasePath);
+  try {
+    for (let index = 0; index < 51; index++)
+      rooms.create({ name: `Room ${index}`, displayName: "Admin" });
+  } finally {
+    rooms.close();
+  }
+  const headers = { authorization: `Bearer ${ADMIN}` };
+  const first = (await f.app.inject({ url: "/api/rooms", headers })).json();
+  const second = (
+    await f.app.inject({
+      url: `/api/rooms?offset=${first.nextOffset}`,
+      headers,
+    })
+  ).json();
+  assert.equal(first.rooms.length, 50);
+  assert.equal(first.nextOffset, 50);
+  assert.equal(second.rooms.length, 1);
+  assert.equal(second.nextOffset, null);
+  assert.equal(
+    new Set(
+      [...first.rooms, ...second.rooms].map((room: { id: string }) => room.id),
+    ).size,
+    51,
+  );
+});
