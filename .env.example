# npm run setup generates the three secrets below without printing them.
PUBLIC_URL=http://localhost:5173
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/freedomstream.db
ADMIN_TOKEN=GENERATE_WITH_NPM_RUN_SETUP
# Private SFU signaling/admin origin. Public signaling uses PUBLIC_URL + /media.
# Keep this listener private; bypassing the admission gateway defeats revocation.
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=GENERATE_WITH_NPM_RUN_SETUP
LIVEKIT_API_SECRET=GENERATE_WITH_NPM_RUN_SETUP
# Optional production-only settings (the dedicated Compose file supplies these).
# TRUSTED_PROXY=172.30.77.1
# PUBLISHER_DIRECTORY=/absolute/path/to/verified/release
